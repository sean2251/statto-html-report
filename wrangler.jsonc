// The site: one Cloudflare Worker (src/worker.js) serving the pages in public/
// and the API, with one D1 database. See README.md.
//
// Keep "name" and "database_name" as they are on a site that's already
// running: Cloudflare finds the site's database by that name, so changing it
// would point the site at a new, empty database. (A Worker connected to GitHub
// uses its own project name; the warning that it differs from "name" is fine.)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statto-team-site",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker answers the API, the team pages (/t/<team>/...) and the old
    // one-team addresses (which redirect to the main team); everything else is a file.
    "run_worker_first": ["/api/*", "/t/*", "/", "/editor", "/tag", "/view", "/settings"]
  },
  // The live site's database: every team's data.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "statto-team-site"
    }
  ],
  "observability": { "enabled": true },
  // Preview builds (a temporary copy of the site for each branch, made by
  // Cloudflare's Workers Builds). Previews inherit nothing from above, so they
  // get their own, separate database here and never touch the live site's
  // data. All previews share it; a new preview starts by claiming it with a
  // setup code. This database ID belongs to the RAMP 2026 site's Cloudflare
  // account: if you deploy your own copy, create a D1 database for previews
  // and put its ID here, or remove this block (and turn off non-production
  // branch builds in Cloudflare).
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "statto-team-site-preview",
        "database_id": "9d629afa-17f3-46e0-b877-042a3121f7be"
      }
    ]
  }
}

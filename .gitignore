# Dependencies and Wrangler's local state (the local database lives here)
node_modules/
.wrangler/
.dev.vars

# Real teams' data never goes in the repo: Statto exports carry players'
# names. Only the made-up example season is checked in.
*.statto
!examples/example_season.statto
*.tagging.json
*_custom_data.json
*-backup.json
*.csv
# Anything named after a real team (both cases: gitignore is case-sensitive).
*RAMP*
*ramp*

# Python (the tests)
__pycache__/
*.pyc
.venv/

# Editor/OS
.DS_Store
.claude/

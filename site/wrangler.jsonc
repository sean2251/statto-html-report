// The team site: one Cloudflare Worker (src/worker.js) serving the pages in
// public/ and the /api routes, with one D1 database. See site/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "statto-team-site",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "statto-team-site"
    }
  ],
  "observability": { "enabled": true }
}
